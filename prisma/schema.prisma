generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  links Link[]
}

model Link {
  id        String    @id @default(cuid())
  slug      String    @unique
  url       String
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  clicks Click[]
}

model Click {
  id        String   @id @default(cuid())
  country   String?
  device    String?
  browser   String?
  createdAt DateTime @default(now())

  linkId String
  link   Link   @relation(fields: [linkId], references: [id])
}
